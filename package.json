{
  "name": "reading-lite",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "description": "Cloudflare Worker reading service: fetch URL, summarize through a configured provider, persist content to R2 and readings to PostgreSQL + pgvector.",
  "scripts": {
    "prepare": "command -v bd >/dev/null 2>&1 && git config core.hooksPath .beads/hooks || true",
    "predev": "tsx scripts/require-dev-node.ts",
    "dev": "npm run dev:setup && wrangler dev",
    "dev:setup": "tsx scripts/dev-setup.ts",
    "seed:local": "tsx scripts/seed-local-fixtures.ts",
    "ops": "tsx scripts/ops.ts",
    "types:generate": "wrangler types worker-configuration.d.ts --include-env=false",
    "types:check": "npm run types:generate -- --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "npm run test:workers:ci && npm run test:node:ci",
    "test:workers:ci": "CI_SCOPE=essential vitest run --project workers",
    "test:node:ci": "CI_SCOPE=essential vitest run --project node",
    "test:quiet": "node scripts/test-quiet.mjs",
    "test:watch": "vitest",
    "fixtures:app": "tsx scripts/emit-app-fixture-pack.ts"
  },
  "dependencies": {
    "@hono/mcp": "^0.3.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mozilla/readability": "^0.5.0",
    "hono": "^4.6.14",
    "linkedom": "^0.18.5",
    "marked": "^14.1.4",
    "pg": "^8.23.0",
    "turndown": "^7.2.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.21",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "@types/turndown": "^5.0.5",
    "@vitest/runner": "~2.1.8",
    "@vitest/snapshot": "~2.1.8",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "aws4fetch": "^1.0.20",
    "playwright": "^1.61.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "~2.1.8",
    "wrangler": "^4.130.0",
    "yaml": "^2.9.0"
  }
}
