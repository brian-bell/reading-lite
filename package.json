{
  "name": "reading-lite",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker reading service: fetch URL, summarize via Claude, persist to R2 + Vectorize.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "tsx scripts/deploy.ts",
    "deploy:web": "tsx scripts/deploy-web.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "read": "tsx scripts/read-url.ts",
    "import-bookmarks": "tsx scripts/import-bookmarks.ts",
    "import-markdown": "tsx scripts/import-markdown.ts",
    "corpus-audit": "tsx scripts/corpus-audit.ts",
    "corpus-recover": "tsx scripts/corpus-recover.ts",
    "corpus-delete-orphans": "tsx scripts/corpus-delete-orphans.ts",
    "corpus-drop": "tsx scripts/corpus-drop.ts",
    "check-corpus": "tsx scripts/check-corpus.ts",
    "process-reading-list": "tsx scripts/process-reading-list.ts"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "hono": "^4.6.14",
    "linkedom": "^0.18.5",
