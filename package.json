{
  "name": "reading-lite",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker reading service: fetch URL, summarize through a configured provider, persist to R2 + Vectorize.",
  "scripts": {
    "dev": "npm run dev:setup && wrangler dev",
    "dev:setup": "tsx scripts/dev-setup.ts",
    "deploy": "tsx scripts/deploy.ts",
    "deploy:web": "tsx scripts/deploy-web.ts",
    "staging:setup": "tsx scripts/staging-setup.ts",
    "staging:teardown": "tsx scripts/staging-teardown.ts",
    "ops": "tsx scripts/ops.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:quiet": "node scripts/test-quiet.mjs",
    "test:watch": "vitest",
    "import-bookmarks": "tsx scripts/import-bookmarks.ts",
    "reddit-import": "tsx scripts/reddit-import.ts",
    "youtube-import": "tsx scripts/youtube-import.ts",
    "corpus-ingest": "tsx scripts/corpus-ingest.ts",
    "corpus-delete-orphans": "tsx scripts/corpus-delete-orphans.ts",
    "corpus-drop": "tsx scripts/corpus-drop.ts",
    "corpus-sweep": "tsx scripts/corpus-sweep.ts",
    "corpus-backfill-similarity": "tsx scripts/corpus-backfill-similarity.ts",
    "corpus-backfill-vectors": "tsx scripts/corpus-backfill-vectors.ts",
    "corpus-rebuild-list": "tsx scripts/corpus-rebuild-list.ts",
    "summarizer-eval": "tsx scripts/summarizer-eval.ts",
    "check-corpus": "tsx scripts/check-corpus.ts",
    "process-reading-list": "tsx scripts/process-reading-list.ts",
    "extract-agent": "tsx scripts/extract-agent.ts",
    "extract-agent:probe": "tsx scripts/extract-agent-probe.ts",
    "founder-bootstrap": "tsx scripts/founder-bootstrap.ts",
    "corpus-normalize-tags": "tsx scripts/corpus-normalize-tags.ts"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "hono": "^4.6.14",
    "linkedom": "^0.18.5",
    "marked": "^14.1.4",
    "turndown": "^7.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.21",
    "@cloudflare/workers-types": "^4.20241230.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.5",
    "@types/turndown": "^5.0.5",
    "@vitest/runner": "~2.1.8",
    "@vitest/snapshot": "~2.1.8",
    "aws4fetch": "^1.0.20",
    "better-sqlite3": "^11.7.0",
    "playwright": "^1.61.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "~2.1.8",
    "wrangler": "^4.85.0"
  }
}
