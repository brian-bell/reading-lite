    "turndown": "^7.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.21",
    "@cloudflare/workers-types": "^4.20241230.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.5",
    "@types/turndown": "^5.0.5",
    "@vitest/runner": "~2.1.8",
    "@vitest/snapshot": "~2.1.8",
    "aws4fetch": "^1.0.20",
    "better-sqlite3": "^11.7.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "~2.1.8",
    "wrangler": "^4.85.0"
