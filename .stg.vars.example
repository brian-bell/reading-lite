# Copy to .stg.vars and fill in. .stg.vars is gitignored.
#
# Used by:
#   npm run ops -- deploy worker --env staging [--execute]
#   npm run ops -- deploy web --branch staging [--execute]
#   BASE=<staging-url> READER_API_TOKEN=<staging-token> ./scripts/manual/idempotency-smoke.sh a
#
# Secrets still need to be set in Cloudflare with:
#   wrangler secret put AUTH_ROOT_SECRET --env staging
#   wrangler secret put OPENAI_API_KEY --env staging
#   wrangler secret put X_API_BEARER_TOKEN --env staging
# When SUMMARIZER_PROVIDER=anthropic:
#   wrangler secret put ANTHROPIC_API_KEY --env staging
#
# `ops founder bootstrap` reads AUTH_ROOT_SECRET and READER_API_TOKEN from this
# file (or the process environment), not from Wrangler secrets. The
# AUTH_ROOT_SECRET here must match the Worker secret. READER_API_TOKEN is
# imported as the founder bearer and is not a runtime Worker fallback.
#
# Keep this token different from production.
#
# Cloud Agents: add AUTH_ROOT_SECRET, READER_API_TOKEN, and FOUNDER_EMAIL as
# environment secrets in the Cursor dashboard. `scripts/cloud-agent-install.ts`
# materializes this file on install. Also set CLOUDFLARE_API_TOKEN (and
# CLOUDFLARE_ACCOUNT_ID) so wrangler works without interactive login.

AUTH_ROOT_SECRET=
# Optional during auth-root rotation (defaults to key version 1 when unset):
# AUTH_ROOT_KEY_VERSION=1
# AUTH_PREVIOUS_ROOT_SECRET=
# AUTH_PREVIOUS_ROOT_KEY_VERSION=1
FOUNDER_EMAIL=
READER_API_TOKEN=
OPENAI_API_KEY=
# Required only when importing x.com/twitter.com status URLs.
X_API_BEARER_TOKEN=
# Required only when SUMMARIZER_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
RESEND_API_KEY=
# Optional. Staging bootstrap is invite_only (no Turnstile required). Set these
# before flipping signup_mode to open. TURNSTILE_SECRET_KEY is a wrangler secret
# (`wrangler secret put TURNSTILE_SECRET_KEY --env staging`), never a [vars] value.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Informational overrides; the deployed staging defaults live in wrangler.toml.
SUMMARIZER_PROVIDER=openai
OPENAI_SUMMARIZATION_MODEL=gpt-5.6-terra
OPENAI_SUMMARIZATION_REASONING_EFFORT=high
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_SUMMARIZATION_REASONING_EFFORT=high

# Optional: used only for scripts/manual smoke and docs examples.
READER_URL=https://reading-lite-staging.<workers-subdomain>.workers.dev/readings
BASE=https://reading-lite-staging.<workers-subdomain>.workers.dev
