node_modules/
dist/
# Browser-evidence output (app/, issue #374): screenshots and reports are CI
# artifacts, not commits. app/e2e/fixtures/ is generated but committed.
app/e2e/screenshots/
app/e2e/test-results/
app/e2e/report/
# The design study's build (app/prototypes, `npm run prototype:build`).
app/dist-prototypes/
# The desktop app's local dev-server launch config.
.claude/launch.json
# Playwright's default output when it is run from the repo root by mistake.
/test-results/
.wrangler/
.dev.vars
.stg.vars
.corpus.vars
.extract-agent.vars
.import-bookmarks-index.json
.import-markdown-index.json
.import-reading-list-index.json
