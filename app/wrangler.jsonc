// reading-lite frontend Worker (TanStack Start). See ADR 0003,
// docs/decisions/0003-frontend-worker-topology.md.
//
// Three environments, mirroring the backend's root wrangler.toml:
//   * top level (local) — `npm run dev` only, never deployed. The distinct -dev
//                         name guards against a bare deploy.
//   * staging           — reading-lite-app-staging, binds reading-lite-staging.
//   * production        — reading-lite-app, binds reading-lite.
//
// The build fixes the environment (CLOUDFLARE_ENV=staging|production npm run
// build). Production deploys after every production backend release
// (.github/workflows/deploy-spa.yml); staging deploys by manual dispatch
// (.github/workflows/deploy-app-staging.yml).
//
// Routes (ADR 0003, amended 2026-09-13): each deployed environment owns its
// preview host, next-staging.readinglite.ai or next.readinglite.ai, with a
// `host/*` route. The backend of the same environment keeps the more specific
// /api/*, /health, and (on the public hosts) /mcp* routes there (root
// wrangler.toml), and this Worker returns 404 for backend paths instead of
// proxying them. test/frontend-routes.test.ts fails when a route has no
// matching backend routes. Staging switched at Phase 4 parity (#339,
// 2026-09-16): the staging frontend also owns staging.readinglite.ai/* and
// staging.readinglite.app/*, ahead of the Pages custom domains still bound
// there, which stay as the rollback target (delete the two routes to roll
// back). Production switched at the Phase 5 cutover (reading-lite-gh340.4,
// authorized 2026-09-19) the same way: the production frontend also owns
// readinglite.ai/* and readinglite.app/*, ahead of the Pages custom domains
// that stay bound and deployed as the rollback target (delete the two routes
// to roll back).
//
// BACKEND binds the backend's read-only FrontendReads entrypoint (the repo
// root's src/frontend-reads.ts), used for server renders; browser API calls go
// to the backend's own /api/* routes. test/backend-bindings.test.ts fails when
// an environment's BACKEND service binding names another environment's backend
// or another entrypoint. Environments do not inherit bindings: repeat BACKEND
// in each one. The deploy workflows run scripts/check-build.ts on the built
// config, so a build for the wrong environment or backend never deploys.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reading-lite-app-dev",
  "main": "@tanstack/react-start/server-entry",
  // No public hostname for the local config. Wrangler defaults
  // workers_dev to true, so a bare deploy of this local config would otherwise
  // publish reading-lite-app-dev on workers.dev. Repeated in each environment.
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": true }
  },
  "services": [{ "binding": "BACKEND", "service": "reading-lite-dev", "entrypoint": "FrontendReads" }],
  "env": {
    "staging": {
      "name": "reading-lite-app-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        { "pattern": "next-staging.readinglite.ai/*", "zone_name": "readinglite.ai" },
        { "pattern": "staging.readinglite.ai/*", "zone_name": "readinglite.ai" },
        { "pattern": "staging.readinglite.app/*", "zone_name": "readinglite.app" }
      ],
      "services": [{ "binding": "BACKEND", "service": "reading-lite-staging", "entrypoint": "FrontendReads" }]
    },
    "production": {
      "name": "reading-lite-app",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        { "pattern": "next.readinglite.ai/*", "zone_name": "readinglite.ai" },
        { "pattern": "readinglite.ai/*", "zone_name": "readinglite.ai" },
        { "pattern": "readinglite.app/*", "zone_name": "readinglite.app" }
      ],
      "services": [{ "binding": "BACKEND", "service": "reading-lite", "entrypoint": "FrontendReads" }]
    }
  }
}
