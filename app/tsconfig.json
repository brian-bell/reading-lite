{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    // scripts/ run under Node type stripping, which needs the .ts extension.
    "allowImportingTsExtensions": true
  },
  "include": ["src", "test", "smoke", "config", "scripts", "e2e", "vite.config.ts", "vitest.config.ts", "vitest.smoke.config.ts", "playwright.config.ts"]
}
